# Port configuration
PORT=3000

# PostgreSQL connection string (provisioned via Cloud SQL or external)
DATABASE_URL=

# Set to "qa" only when the connection targets the QA database
DATABASE_TARGET=

# Generate a random secret with at least 32 bytes for session-token hashing
SESSION_SECRET=

# SMTP settings for teacher signup codes. Use a verified sender address.
TEACHER_SMTP_HOST=
TEACHER_SMTP_PORT=
TEACHER_SMTP_SECURE=false
TEACHER_SMTP_USERNAME=
TEACHER_SMTP_PASSWORD=
TEACHER_EMAIL_FROM=

# Exact institution-ID to email-domain mappings maintained by the operator.
# Example: {"district:1234567":["district.example.edu"],"school:123456789012":["school.example.edu"]}
TEACHER_EMAIL_DOMAIN_ALLOWLIST=
