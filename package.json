{
  "name": "quiz-app",
  "version": "1.0.0",
  "description": "Quiz app server built with Express and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "node -e 'console.log(\"Build complete\")'",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --env-file-if-exists=.env --test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  }
}
